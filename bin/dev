#!/usr/bin/env sh

script_dir="$(cd "$(dirname "$0")" && pwd)"

# use the local procfile variant if one exists next to it
if [ -f "$script_dir/../Procfile.local" ]; then
  export OVERMIND_PROCFILE="$script_dir/../Procfile.local"
fi

if ! gem list overmind -i --silent; then
  echo "Installing overmind..."
  gem install overmind
fi

if ! gem list mailcatcher -i --silent; then
  echo "Installing mailcatcher..."
  gem install mailcatcher
fi

DISABLE_SPRING=1 OVERMIND_SHOW_TIMESTAMPS=1 OVERMIND_CAN_DIE=migrate exec overmind start "$@"
