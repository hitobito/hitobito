- title t('.sign_in', name: Settings.application.name)

.fields-separation
  = render "oauth_logo", oauth_app: oauth_application

  %p
    - if oauth_application.present?
      = t('.info', oauth_app: oauth_application.name)
    - else
      = t('.no_oauth_app_info')
  %hr
