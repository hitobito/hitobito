#events
  - @participations_by_event_type.each_with_index do |(type , participations), index|
    = render layout: 'person/history/section', locals: { id: "events_#{index}", title: type } do
      = table(participations, class: 'table table-striped table-fixed') do |t|
        - t.col(t('person.history.events.event_label')) do |p|
          = p.event.labeled_link
        - t.col(Role.model_name.human) do |p|
          = p.labeled_link(p.list_roles)
        - t.col(Event::Date.model_name.human(count: 2)) do |p|
          = p.event.dates_full
        - if participations.first.event.is_a?(Event::Course)
          - t.col(Qualification.model_name.human) do |p|
            = render 'person/history/course_qualification', p: p
            = render 'person/history/course_training_days', p: p
        - else
          - t.col('') {}
