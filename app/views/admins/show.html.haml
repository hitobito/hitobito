.container{style: 'margin-left: 1rem'}
  .row.row-cols-1.row-cols-sm-2.row-cols-md-3.row-cols-lg-4
    - admin_groups_by_heading.each do |_key, group|
      - items = admin_group_items(group)
      - next if items.empty?
      .col
        %h2= t(group[:heading])
        %ul.container
          - items.each do |item|
            %li= link_to item.label(self), item.url(self)
