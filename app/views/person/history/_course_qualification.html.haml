- comments_enabled = FeatureGate.enabled?('event.qualifications.comments')
- if p.event.qualifications_visible? && (!comments_enabled || !p.qualified.nil?)
  = t("person.history.index.#{p.qualified ? '' : 'not_'}qualified")
  - if comments_enabled && p.qualification_comment.present?
    = icon(:"info-circle", title: p.qualification_comment, class: 'ms-1')
  %br
