#!/usr/bin/env bash

export WAGONS=''
export RAILS_ENV=test
# export RAILS_TEST_DB_NAME=hit_core_test

# ensure that schema.rb is current for the test-db to load
# bundle exec rake db:migrate

if [[ $DISABLE_SPRING ]]; then
  # Load rspec gem directly to avoid recursion via PATH resolution
  # (`bundle exec rspec` would find this very script again)
  bundle exec ruby -e 'load Gem.bin_path("rspec-core", "rspec")' -- $@
else
  bundle exec spring rspec $@
fi
