- errors = participation.errors[:qualification_comment]
= text_field_tag("qualifications[#{participation.id}][qualification_comment]",
                 participation.qualification_comment,
                 class: "form-control form-control-sm #{'is-invalid' if errors.present?}",
                 'aria-label': t('event.qualifications.index.comment'))
- if errors.present?
  .invalid-feedback.d-block= errors.to_sentence
