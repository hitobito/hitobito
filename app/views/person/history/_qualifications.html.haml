- { current_qualifications: @current_qualifications,
    expired_qualifications: @expired_qualifications }.each do |key, list|
  - if list.present?
    = render layout: 'person/history/section', locals: { id: key, title: t(".#{key}") } do
      = table(list, class: 'table table-striped table-fixed') do |t|
        - t.attr(:qualification_kind, class: "col-2")
        - t.attr(:origin, class: "col-2")
        - t.attr(:start_at, class: "col-1")
        - t.attr(:finish_at, class: "col-1")
        - t.attr(:reactivateable_until, class: "col-1")
        - if key == :current_qualifications
          - t.attr(:open_training_days, class: "col-1") do |q|
            = q.decorate.open_training_days_info
        - else
          - t.col('', class: "col-1") {}
