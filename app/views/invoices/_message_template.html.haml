- templates = group.invoice_config.message_templates.includes(:translations)
- if templates.any?
  - options = LocaleSetter.with_locale(person: local_assigns[:recipient]) { templates.map(&:option_for_select) }
  = f.labeled(MessageTemplate.model_name.human) do
    = select_tag('message_template_id', options_for_select(options), include_blank: "",
      class: "form-select form-select-sm", data: { message_template_id: true })
