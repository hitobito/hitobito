.row.row-cols-1.row-cols-sm-2.row-cols-lg-3.row-cols-xl-4.g-4
  - ordered_admin_groups.each do |_key, group|
    - items = admin_group_items(group)
    - next if items.empty?
    .col
      .card
        .card-header
          %h2.h5.mt-1= t(group[:heading])
        %ul.list-group.list-group-flush
          - items.each do |item|
            %li.list-group-item= link_to item.label(self), item.url(self)
