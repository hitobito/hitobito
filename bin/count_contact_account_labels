#!/usr/bin/env ruby
# frozen_string_literal: true

#  Copyright (c) 2026, Puzzle ITC. This file is part of
#  hitobito and licensed under the Affero General Public License version 3
#  or later. See the COPYING file at the top-level directory or at
#  https://github.com/hitobito/hitobito.

# Reports contact-account label usage, to help decide which
# ContactAccountCategory keys/mappings are still missing. If a row already
# has a category (e.g. after running the real or dry-run migration), its
# name is shown in brackets next to the label. Also usable as a library --
# being extensionless, `load` it rather than `require_relative` it (see
# bin/dry_run_contact_account_categories for an example).
#
# Usage: bin/count_contact_account_labels [current|all]
#   current (default) - only the currently configured database
#   all                - every wagon's production database, with a
#                        per-database breakdown under each label

require_relative "../config/environment"

ACCOUNT_TYPES = [PhoneNumber, AdditionalEmail, SocialAccount, AdditionalAddress].freeze
MIN_COUNT = 3
MODE = ARGV.first || "current"

def wagons
  `bin/wagon list`.split
end

def connect_to(base_config, wagon)
  ActiveRecord::Base.establish_connection(base_config.merge(database: "hit_#{wagon}_prod"))
  ActiveRecord::Base.connection.current_database.tap do
    (ACCOUNT_TYPES + [ContactAccountCategory]).each(&:reset_column_information)
  end
end

# Category ids are only meaningful within one database, so they're
# resolved to their (database-independent) name right away rather than
# kept in the grouping key -- callers may aggregate counts across
# multiple databases.
def category_names_by_id(ids)
  ContactAccountCategory.where(id: ids).includes(:translations).to_h { |c| [c.id, c.to_s] }
end

def label_counts(type)
  return type.group(:contactable_type, :label).count.transform_keys { |k| [*k, nil] } unless
    type.column_names.include?("category_id")

  counts = type.group(:contactable_type, :label, :category_id).count
  names = category_names_by_id(counts.keys.map { |(*, category_id)| category_id }.compact.uniq)
  counts.to_h { |(contactable_type, label, category_id), count|
    [[contactable_type, label, names[category_id]], count]
  }
end

def counts_for_database(database)
  puts "Reading #{database}"
  ACCOUNT_TYPES.to_h { |type| [type, label_counts(type)] }
end

# {database => {type => {[contactable_type, label] => count}}}
def collect_counts_for_current_database
  database = ActiveRecord::Base.connection.current_database
  {database => counts_for_database(database)}
end

def collect_counts_across_wagons
  base_config = ActiveRecord::Base.connection_db_config.configuration_hash

  wagons.to_h do |wagon|
    database = connect_to(base_config, wagon)
    [database, counts_for_database(database)]
  rescue => e
    warn "Skipping #{wagon}: #{e.message}"
    [wagon, nil]
  end.compact
end

def collect_counts
  case MODE
  when "current" then collect_counts_for_current_database
  when "all" then collect_counts_across_wagons
  else abort "Usage: bin/count_contact_account_labels [current|all]"
  end
end

def total_counts(counts_by_database, type)
  counts_by_database.each_value.with_object(Hash.new(0)) do |database_counts, totals|
    database_counts[type].each { |key, count| totals[key] += count }
  end
end

def print_label(counts_by_database, type, key, count)
  contactable_type, label, category_name = key
  category_suffix = category_name ? " [#{category_name}]" : ""
  puts "  #{contactable_type},#{label}#{category_suffix}: #{count}"
  return if counts_by_database.size <= 1

  counts_by_database.each do |database, database_counts|
    database_count = database_counts[type][key]
    puts "    #{database}: #{database_count}" if database_count&.positive?
  end
end

def print_counts(counts_by_database)
  ACCOUNT_TYPES.each do |type|
    totals = total_counts(counts_by_database, type).select { |_key, count| count > MIN_COUNT }
    next if totals.empty?

    puts "== #{type}"
    sorted = totals.sort_by { |_key, count| -count }
    sorted.each { |key, count| print_label(counts_by_database, type, key, count) }
    puts
  end
end

print_counts(collect_counts) if $PROGRAM_NAME == __FILE__
