- if qualifications.present?
  %h2.mt-4=Qualification.model_name.human(count: 2)
  = table(qualifications, class: 'table table-striped table-fixed') do |t|
    - t.attr(:qualification_kind, style: 'width: 25%') do |q|
      - if q.first_reactivateable?
        %strong= q.qualification_kind
      - else
        = q.qualification_kind
    - t.attr(:origin, style: 'width: 20%')
    - t.attr(:start_at, style: 'width: 12%')
    - t.attr(:finish_at, style: 'width: 12%')
    - t.attr(:reactivateable_until, style: 'width: 16%')
    - t.attr(:open_training_days, style: 'width: 15%') do |q|
      - if q.first_of_kind?
        = q.decorate.open_training_days_info
