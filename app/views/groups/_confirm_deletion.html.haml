#confirm-group-deletion.modal.fade{data: {controller: 'confirm-deletion', 'confirm-deletion-expected-value': entry.name}}
  .modal-dialog.mw-fit-content
    .modal-content
      .modal-header
        %h5.bold.modal-title
          %b= t('.title', group_name: entry.name)
      .modal-body
        %p
          = t('.warning')
        %p
          = t('.confirmation', group_name: entry.name)
        = text_field_tag 'group-name', nil,
          class: 'form-control form-control-sm',
          data: {action: 'confirm-deletion#validate'}
      .modal-footer
        = form_with(url: group_path(entry), method: :delete, local: true, class: 'd-inline') do |f|
          = f.button(type: :submit,
            class: 'btn btn-danger',
            disabled: true,
            data: {'confirm-deletion-target': 'submitButton'}) do
            = safe_join([icon('trash-alt'), t('.delete')], ' ')
        = link_to(ti('button.cancel'), '#',
          class: 'link cancel',
          onclick: "event.preventDefault(); $('#confirm-group-deletion').modal('hide')")
